# Belezza API - Environment Variables Example
# Copy this file to .env and fill in the values

# Database
# Obrigatória no docker-compose (sem padrão). Gere uma senha forte: openssl rand -base64 24
# O Postgres só a usa ao criar o volume; se o volume já existe, use a senha com que foi criado.
DB_PASSWORD=troque-esta-senha-do-banco

# JWT Secret (min 256 bits / 32 characters)
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# Senha do admin inicial (admin@belezza.ai), só em produção (perfil prod/staging), mín. 12
# caracteres. Sem ela, a conta criada pelas migrations com a senha pública "Admin@123" é
# desativada ao subir, assim como as contas de demonstração (BUG-004).
BELEZZA_ADMIN_INICIAL_SENHA=

# Redis — obrigatória no docker-compose (o Redis passou a exigir senha)
REDIS_PASSWORD=troque-esta-senha-do-redis

# WhatsApp Business API (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Meta Graph API (Instagram/Facebook)
META_APP_ID=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# OpenAI API
OPENAI_API_KEY=

# Replicate API
REPLICATE_API_TOKEN=

# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=belezza-images
AWS_S3_REGION=sa-east-1
AWS_CLOUDFRONT_DOMAIN=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# PgAdmin (optional)
PGADMIN_EMAIL=admin@belezza.ai
PGADMIN_PASSWORD=admin
