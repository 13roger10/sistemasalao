# Senhas do docker-compose.yml desta pasta (ambiente local com Docker).
# Copie para .env e troque os valores — o .env não é versionado.
# Gere senhas fortes, por exemplo: openssl rand -base64 24
#
# Atenção: o Postgres só usa DB_PASSWORD ao criar o volume pela primeira vez. Se o volume
# belezza-postgres já existe, use a senha com que ele foi criado (antes o padrão era belezza123)
# ou recrie o volume com: docker compose down -v

DB_PASSWORD=troque-esta-senha-do-banco
REDIS_PASSWORD=troque-esta-senha-do-redis

# Segredos do backend (obrigatórios: o backend não sobe sem eles).
# JWT_SECRET: no mínimo 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-de-pelo-menos-32-caracteres
# AES_SECRET_KEY: exatamente 32 caracteres. Criptografa os tokens das redes sociais no banco;
# trocar a chave torna ilegíveis os tokens já gravados (reconecte as contas).
AES_SECRET_KEY=troque-esta-chave-de-32-caracter
